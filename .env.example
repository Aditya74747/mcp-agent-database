# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# --- Model ------------------------------------------------------------------
# Local & free (default). Pull first: `ollama pull qwen3:8b`
FORGE_LLM_PROVIDER=ollama
FORGE_MODEL=qwen3:8b
FORGE_OLLAMA_BASE_URL=http://localhost:11434
# FORGE_OLLAMA_THINK=false          # true = let reasoning models think (slower, sometimes better)

# Any OpenAI-compatible server (OpenAI, vLLM, LM Studio, Groq, OpenRouter, Ollama's /v1):
# FORGE_LLM_PROVIDER=openai
# FORGE_MODEL=<a current OpenAI model, or the model name your server hosts>
# FORGE_OPENAI_API_KEY=sk-...
# FORGE_OPENAI_BASE_URL=http://localhost:8000/v1   # omit for api.openai.com

# Claude:
# FORGE_LLM_PROVIDER=anthropic
# FORGE_MODEL=claude-sonnet-5-5
# FORGE_ANTHROPIC_API_KEY=sk-ant-...

# --- Agent ------------------------------------------------------------------
# ask | auto_approve | auto_deny
FORGE_APPROVAL_MODE=ask
# Tools that never need approval (comma-separated, server__tool):
# FORGE_TRUSTED_TOOLS=workspace__write_file
FORGE_MAX_STEPS=10

# --- Servers ----------------------------------------------------------------
# Hybrid (BM25 + vector) document search; requires `ollama pull nomic-embed-text`
# FORGE_EMBED_MODEL=nomic-embed-text
# Needed only for github_create_issue (fine-grained token, Issues: write on one test repo)
# FORGE_GITHUB_TOKEN=github_pat_...

# --- API --------------------------------------------------------------------
# Require `Authorization: Bearer <token>` on /v1/* routes
# FORGE_API_TOKEN=change-me
